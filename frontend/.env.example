# Frontend environment configuration
# Copy this file to `.env` and adjust the values for your environment.

# Target URL for the backend API and media proxy.
# The Vite dev server forwards requests to `/api` and `/media` to this host.
# Default (when unset) is http://127.0.0.1:8000.
VITE_PROXY_TARGET=http://127.0.0.1:8000
